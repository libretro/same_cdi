	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/crc.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/fixed.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/format.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/lpc.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/md5.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/memory.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/stream_decoder.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/stream_encoder.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/stream_encoder_framing.c \
	$(CORE_DIR)/3rdparty/libflac/src/libFLAC/window.c

FLAC_OBJS := $(patsubst $(CORE_DIR)/%,$(CORE_OBJ_DIR)/%,$(FLAC_SRC_C:.c=.o))
$(FLAC_OBJS): GRPINCS := -I$(CORE_DIR)/3rdparty/libflac/src/libFLAC/include -I$(CORE_DIR)/3rdparty/libflac/include
$(FLAC_OBJS): GRPFLAGS := -DWORDS_BIGENDIAN=0 -DFLAC__NO_ASM -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -DFLAC__HAS_OGG=0 -DHAVE_CONFIG_H=1
OBJECTS += $(FLAC_OBJS)

##############################################################################
