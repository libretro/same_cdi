	$(CORE_DIR)/3rdparty/libjpeg/jddctmgr.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdhuff.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdinput.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdmainct.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdmarker.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdmaster.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdmerge.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdpostct.c \
	$(CORE_DIR)/3rdparty/libjpeg/jdsample.c \
	$(CORE_DIR)/3rdparty/libjpeg/jerror.c \
	$(CORE_DIR)/3rdparty/libjpeg/jidctflt.c \
	$(CORE_DIR)/3rdparty/libjpeg/jidctfst.c \
	$(CORE_DIR)/3rdparty/libjpeg/jidctint.c \
	$(CORE_DIR)/3rdparty/libjpeg/jmemansi.c \
	$(CORE_DIR)/3rdparty/libjpeg/jmemmgr.c \
	$(CORE_DIR)/3rdparty/libjpeg/jquant1.c \
	$(CORE_DIR)/3rdparty/libjpeg/jquant2.c \
	$(CORE_DIR)/3rdparty/libjpeg/jutils.c

JPEG_OBJS := $(patsubst $(CORE_DIR)/%,$(CORE_OBJ_DIR)/%,$(JPEG_SRC_C:.c=.o))
$(JPEG_OBJS): GRPFLAGS :=
OBJECTS += $(JPEG_OBJS)

##############################################################################
# 7z
##############################################################################
LZMA_SRC_C := \
	$(CORE_DIR)/3rdparty/lzma/C/7zAlloc.c \
	$(CORE_DIR)/3rdparty/lzma/C/7zArcIn.c \
	$(CORE_DIR)/3rdparty/lzma/C/7zBuf.c \
	$(CORE_DIR)/3rdparty/lzma/C/7zCrc.c \
	$(CORE_DIR)/3rdparty/lzma/C/7zCrcOpt.c \
	$(CORE_DIR)/3rdparty/lzma/C/7zDec.c \
	$(CORE_DIR)/3rdparty/lzma/C/7zStream.c \
	$(CORE_DIR)/3rdparty/lzma/C/Bcj2.c \
	$(CORE_DIR)/3rdparty/lzma/C/Bra.c \
	$(CORE_DIR)/3rdparty/lzma/C/Bra86.c \
	$(CORE_DIR)/3rdparty/lzma/C/BraIA64.c \
	$(CORE_DIR)/3rdparty/lzma/C/CpuArch.c \
	$(CORE_DIR)/3rdparty/lzma/C/Delta.c \
	$(CORE_DIR)/3rdparty/lzma/C/LzFind.c \
	$(CORE_DIR)/3rdparty/lzma/C/Lzma2Dec.c \
	$(CORE_DIR)/3rdparty/lzma/C/LzmaDec.c \
	$(CORE_DIR)/3rdparty/lzma/C/LzmaEnc.c \
	$(CORE_DIR)/3rdparty/lzma/C/Ppmd7.c \
	$(CORE_DIR)/3rdparty/lzma/C/Ppmd7Dec.c

LZMA_OBJS := $(patsubst $(CORE_DIR)/%,$(CORE_OBJ_DIR)/%,$(LZMA_SRC_C:.c=.o))
$(LZMA_OBJS): GRPFLAGS := -D_7ZIP_PPMD_SUPPPORT -D_7ZIP_ST
OBJECTS += $(LZMA_OBJS)

##############################################################################
# utf8proc
##############################################################################
UTF8PROC_SRC_C := \
	$(CORE_DIR)/3rdparty/utf8proc/utf8proc.c

UTF8PROC_OBJS := $(patsubst $(CORE_DIR)/%,$(CORE_OBJ_DIR)/%,$(UTF8PROC_SRC_C:.c=.o))
$(UTF8PROC_OBJS): GRPFLAGS := -DUTF8PROC_STATIC
OBJECTS += $(UTF8PROC_OBJS)

##############################################################################
# Link layout
#
# The old system linked the mess "exe" objects against per-project static
# archives; archive members are only pulled in when referenced.  Several
# compiled objects (legscsi, mfmhd, ...) reference devices that are not part
# of this build and are never pulled.  A flat object link would fail on those
# dangling references, so the archive structure is preserved.
##############################################################################

# Objects linked directly (the old "mess" exe project)
LINK_OBJS := $(MESS_OBJS)

# Archives, in the old LIBDEPS order
CORE_ARCHIVES := \
	$(CORE_OBJ_DIR)/libmame_mess.a \
	$(CORE_OBJ_DIR)/libfrontend.a \
	$(CORE_OBJ_DIR)/libemu.a \
	$(CORE_OBJ_DIR)/liboptional.a \
	$(CORE_OBJ_DIR)/libdasm.a \
	$(CORE_OBJ_DIR)/libformats.a \
	$(CORE_OBJ_DIR)/libutils.a \
	$(CORE_OBJ_DIR)/libosd_retro.a \
	$(CORE_OBJ_DIR)/libocore_retro.a \
	$(CORE_OBJ_DIR)/libzlib.a \
	$(CORE_OBJ_DIR)/libflac.a \
	$(CORE_OBJ_DIR)/libjpeg.a \
	$(CORE_OBJ_DIR)/liblzma.a \
	$(CORE_OBJ_DIR)/libutf8proc.a

$(CORE_OBJ_DIR)/libmame_mess.a: $(MAME_MESS_OBJS)
$(CORE_OBJ_DIR)/libfrontend.a: $(FRONTEND_OBJS)
$(CORE_OBJ_DIR)/libemu.a: $(EMU_OBJS)
$(CORE_OBJ_DIR)/liboptional.a: $(OPTIONAL_OBJS)
$(CORE_OBJ_DIR)/libdasm.a: $(DASM_OBJS)
$(CORE_OBJ_DIR)/libformats.a: $(FORMATS_OBJS)
$(CORE_OBJ_DIR)/libutils.a: $(UTILS_OBJS)
$(CORE_OBJ_DIR)/libosd_retro.a: $(OSD_RETRO_OBJS)
$(CORE_OBJ_DIR)/libocore_retro.a: $(OCORE_RETRO_OBJS)
$(CORE_OBJ_DIR)/libzlib.a: $(ZLIB_OBJS)
$(CORE_OBJ_DIR)/libflac.a: $(FLAC_OBJS)
$(CORE_OBJ_DIR)/libjpeg.a: $(JPEG_OBJS)
$(CORE_OBJ_DIR)/liblzma.a: $(LZMA_OBJS)
$(CORE_OBJ_DIR)/libutf8proc.a: $(UTF8PROC_OBJS)

$(CORE_ARCHIVES):
	@echo "AR $@"
	@rm -f $@
	@$(AR) rcs $@ $^
