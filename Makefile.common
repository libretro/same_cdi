##############################################################################
# Makefile.common -- static source lists for same_cdi (MAME 0.239, cdi.cpp)
#
# All build system generation (GENie/regenie) has been removed.  Sources,
# defines and include paths below were extracted from the project files GENie
# produced for TARGET=mame SUBTARGET=mess SOURCES=src/mame/drivers/cdi.cpp
# OSD=retro, and are now maintained by hand.
#
# Formerly-generated files (driver list, layouts, fonts, version) are
# committed under gen/.
#
# Expects from includer: CORE_DIR, CORE_OBJ_DIR, and OS selection vars
# (platform_is_windows/linux/macosx/android = 1/empty).
##############################################################################

GEN_DIR := $(CORE_DIR)/gen

INCFLAGS := \
	-I$(CORE_DIR)/src/osd \
	-I$(CORE_DIR)/src/emu \
	-I$(CORE_DIR)/src/devices \
	-I$(CORE_DIR)/src/mame \
	-I$(CORE_DIR)/src/frontend/mame \
	-I$(CORE_DIR)/src/lib \
	-I$(CORE_DIR)/src/lib/util \
	-I$(CORE_DIR)/src/lib/netlist \
	-I$(CORE_DIR)/src/osd/modules/file \
	-I$(CORE_DIR)/src/osd/modules/render \
	-I$(CORE_DIR)/src/osd/libretro \
	-I$(CORE_DIR)/src/osd/libretro/libretro-internal \
	-I$(GEN_DIR) \
	-I$(GEN_DIR)/emu \
	-I$(GEN_DIR)/emu/layout \
	-I$(GEN_DIR)/mame/layout \
	-I$(CORE_DIR)/3rdparty \
	-I$(CORE_DIR)/3rdparty/zlib \
	-I$(CORE_DIR)/3rdparty/libflac/include \
	-I$(CORE_DIR)/3rdparty/libjpeg \
	-I$(CORE_DIR)/3rdparty/pugixml/src \
	-I$(CORE_DIR)/3rdparty/utf8proc

ifeq ($(platform_is_windows), 1)
INCFLAGS += -I$(CORE_DIR)/src/osd/windows -I$(CORE_DIR)/3rdparty/compat/mingw -I$(CORE_DIR)/3rdparty/compat/winsdk-override
endif

# Defines common to every translation unit
COREDEFINES := -D__LIBRETRO__ -DNDEBUG -DFLAC__NO_DLL -DPUGIXML_HEADER_ONLY

ifeq ($(platform_is_windows), 1)
COREDEFINES += -DCRLF=3 -DUNICODE -D_UNICODE -Dmain=utf8_main -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0501
else
COREDEFINES += -DCRLF=2
endif

ifneq ($(BIGENDIAN), 1)
COREDEFINES += -DLSB_FIRST
endif

ifeq ($(PTR64), 1)
COREDEFINES += -DPTR64=1
endif

# Every TU is compiled with the retro prefix header, as under the old system
COREDEFINES += -include $(CORE_DIR)/src/osd/libretro/retroprefix.h

# OSD layer defines (osd_retro/ocore_retro groups only, as before)
OSDDEFS := -DRETROMAME -DOSD_RETRO
ifneq ($(platform_is_windows), 1)
OSDDEFS += -DSDLMAME_UNIX -DRETROMAME_UNIX
endif
ifeq ($(platform_is_linux), 1)
ifneq ($(DONT_USE_NETWORK), 1)
OSDDEFS += -DUSE_NETWORK -DOSD_NET_USE_TAPTUN
endif
endif
ifeq ($(platform_is_macosx), 1)
OSDDEFS += -DSDLMAME_MACOSX -DSDLMAME_DARWIN
endif


