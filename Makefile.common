	$(CORE_DIR)/src/osd/libretro/libretro-internal/libretro.cpp \
	$(CORE_DIR)/src/osd/libretro/retromain.cpp

MESS_OBJS := $(patsubst $(CORE_DIR)/%,$(CORE_OBJ_DIR)/%,$(MESS_SRC_CXX:.cpp=.o))
$(MESS_OBJS): GRPFLAGS :=
OBJECTS += $(MESS_OBJS)

