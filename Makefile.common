##############################################################################
# Link layout
#
# The old system linked the mess "exe" objects against per-project static
# archives; archive members are only pulled in when referenced.  Several
# compiled objects (legscsi, mfmhd, ...) reference devices that are not part
# of this build and are never pulled.  A flat object link would fail on those
# dangling references, so the archive structure is preserved.
##############################################################################

# Objects linked directly (the old "mess" exe project)
LINK_OBJS := $(MESS_OBJS)

# Archives, in the old LIBDEPS order
CORE_ARCHIVES := \
	$(CORE_OBJ_DIR)/libmame_mess.a \
	$(CORE_OBJ_DIR)/libfrontend.a \
	$(CORE_OBJ_DIR)/libemu.a \
	$(CORE_OBJ_DIR)/liboptional.a \
	$(CORE_OBJ_DIR)/libdasm.a \
	$(CORE_OBJ_DIR)/libformats.a \
	$(CORE_OBJ_DIR)/libutils.a \
	$(CORE_OBJ_DIR)/libosd_retro.a \
	$(CORE_OBJ_DIR)/libocore_retro.a \
	$(CORE_OBJ_DIR)/libsoftfloat.a \
	$(CORE_OBJ_DIR)/libsoftfloat3.a \
	$(CORE_OBJ_DIR)/libexpat.a \
	$(CORE_OBJ_DIR)/libzlib.a \
	$(CORE_OBJ_DIR)/libflac.a \
	$(CORE_OBJ_DIR)/libjpeg.a \
	$(CORE_OBJ_DIR)/liblzma.a \
	$(CORE_OBJ_DIR)/liblua.a \
	$(CORE_OBJ_DIR)/liblualibs.a \
	$(CORE_OBJ_DIR)/libsqlite3.a \
	$(CORE_OBJ_DIR)/liblinenoise.a \
	$(CORE_OBJ_DIR)/libutf8proc.a

$(CORE_OBJ_DIR)/libmame_mess.a: $(MAME_MESS_OBJS)
$(CORE_OBJ_DIR)/libfrontend.a: $(FRONTEND_OBJS)
$(CORE_OBJ_DIR)/libemu.a: $(EMU_OBJS)
$(CORE_OBJ_DIR)/liboptional.a: $(OPTIONAL_OBJS)
$(CORE_OBJ_DIR)/libdasm.a: $(DASM_OBJS)
$(CORE_OBJ_DIR)/libformats.a: $(FORMATS_OBJS)
$(CORE_OBJ_DIR)/libutils.a: $(UTILS_OBJS)
$(CORE_OBJ_DIR)/libosd_retro.a: $(OSD_RETRO_OBJS)
$(CORE_OBJ_DIR)/libocore_retro.a: $(OCORE_RETRO_OBJS)
$(CORE_OBJ_DIR)/libsoftfloat.a: $(SOFTFLOAT_OBJS)
$(CORE_OBJ_DIR)/libsoftfloat3.a: $(SOFTFLOAT3_OBJS)
$(CORE_OBJ_DIR)/libexpat.a: $(EXPAT_OBJS)
$(CORE_OBJ_DIR)/libzlib.a: $(ZLIB_OBJS)
$(CORE_OBJ_DIR)/libflac.a: $(FLAC_OBJS)
$(CORE_OBJ_DIR)/libjpeg.a: $(JPEG_OBJS)
$(CORE_OBJ_DIR)/liblzma.a: $(LZMA_OBJS)
$(CORE_OBJ_DIR)/liblua.a: $(LUA_OBJS)
$(CORE_OBJ_DIR)/liblualibs.a: $(LUALIBS_OBJS)
$(CORE_OBJ_DIR)/libsqlite3.a: $(SQLITE3_OBJS)
$(CORE_OBJ_DIR)/liblinenoise.a: $(LINENOISE_OBJS)
$(CORE_OBJ_DIR)/libutf8proc.a: $(UTF8PROC_OBJS)

$(CORE_ARCHIVES):
	@echo "AR $@"
	@rm -f $@
	@$(AR) rcs $@ $^
